# Keep real credentials outside this directory; use STUDYWINDOW_ENV_FILE.
TINYFISH_API_KEY=
# New installations default to live disabled. Explicitly enable after reviewing pricing.
STUDYWINDOW_LIVE=0
# Private durable state shared by every instance of this build.
STUDYWINDOW_STATE_DIR=

# Only after verifying your current account tier. Omit for a generic Fetch meter.
# STUDYWINDOW_FETCH_TIER=hobby
# A paid Builder Fetch rate is blocked by the reviewed $0 ceiling.
