{
  "name": "studywindow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-grounded continuing-education decisions over MCP, powered by TinyFish.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/stdio.js",
    "demo": "node dist/demo-server.js",
    "health": "node dist/cli.js health_check '{}'",
    "call": "node dist/cli.js",
    "verify:mcp": "node dist/verify-mcp.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"demo/*.{html,css,js}\" \"docs/**/*.md\" README.md package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"demo/*.{html,css,js}\" \"docs/**/*.md\" README.md package.json tsconfig.json .prettierrc.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "cheerio": "1.2.0",
    "playwright-core": "^1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
